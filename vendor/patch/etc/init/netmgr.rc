# note13-5G-15 网络初始化（对齐真机 gold）：管理网卡留在主 netns（改名 mgmt0，
# 10.0.2.15/24，无默认路由），/mnt/run/adb_net 指向 init 主 netns —— adbd（daemon
# setns 后 exec）与 adb shell 因而都在主 netns，与真机一样能看到 ccmni2/wlan0 等；
# 各服务以 u:r:pioneer:s0 运行（内核 permissive，无需逐条授权）；capabilities
# NET_ADMIN SYS_ADMIN 供 ip link/addr 使用。
service vendor.netmgr_setup /vendor/bin/netmgr_setup setup
    class core
    user root
    group root shell
    seclabel u:r:pioneer:s0
    capabilities NET_ADMIN SYS_ADMIN
    disabled
    oneshot

service vendor.netmgr_configure /vendor/bin/netmgr_setup configure
    class core
    user root
    group root shell
    seclabel u:r:pioneer:s0
    capabilities NET_ADMIN SYS_ADMIN
    disabled
    oneshot

# 网络指纹对齐（真机 gold）：net2 网卡改名 ccmni2、建 dummy0 / dummy ccmni0(240e:: IPv6)。
service vendor.netmgr_fingerprint /vendor/bin/netmgr_setup fingerprint
    class core
    user root
    group root shell
    seclabel u:r:pioneer:s0
    capabilities NET_ADMIN SYS_ADMIN
    disabled
    oneshot

on post-fs
    exec_start vendor.netmgr_setup
    exec_start vendor.netmgr_configure
    exec_start vendor.netmgr_fingerprint